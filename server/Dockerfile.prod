FROM golang:1.25-alpine AS goose-builder

RUN go install github.com/pressly/goose/v3/cmd/goose@v3.26.0

FROM alpine:latest
WORKDIR /app

# Copy the pre-built binary
COPY server .
COPY --from=goose-builder /go/bin/goose /usr/local/bin/goose
COPY db/migrations /app/db/migrations

# tzdata for timezone support; Chromium and fonts (Liberation stands in for Times New Roman,
# Noto covers Vietnamese) print the web app's print pages to PDF.
RUN apk add --no-cache tzdata chromium font-liberation font-noto

EXPOSE 8080

CMD ["./server"]
