FROM golang:1.25-alpine AS goose-builder

RUN go install github.com/pressly/goose/v3/cmd/goose@v3.26.0

FROM alpine:latest
WORKDIR /app

# Copy the pre-built binary
COPY server .
COPY --from=goose-builder /go/bin/goose /usr/local/bin/goose
COPY db/migrations /app/db/migrations

# tzdata for timezone support. PDFs are set in Times New Roman: mount the .ttf files at
# /app/fonts (PDF_FONT_DIR); without them Liberation Serif (same metrics) is used.
RUN apk add --no-cache tzdata font-liberation

EXPOSE 8080

CMD ["./server"]
