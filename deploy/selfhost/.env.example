# ============================================================
# Kairso self-host — copy to .env and fill in the 4 marked lines.
# Everything else has working defaults.
# ============================================================
COMPOSE_FILE=docker-compose.yml:docker-compose.bundled.yml

# URL people open (no trailing slash) and the host port.
PUBLIC_URL=http://localhost:8080
PUBLIC_PORT=8080

# (1) Passwords for the bundled PostgreSQL and MinIO (MinIO: at least 8 chars).
DB_PASSWORD=change-me
MINIO_ACCESS_KEY=kairso
MINIO_SECRET_KEY=change-me-please

# (2) Firebase web config (Project settings > Your apps > SDK config).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# FIREBASE_VAPID_KEY=                   # optional: web push notifications

# (3) Firebase service account: save the JSON next to this file as
#     firebase-credentials.json  (Project settings > Service accounts > Generate key)

# ---- Optional -----------------------------------------------------------------
# KAIRSO_TAG=latest                     # pin a version, e.g. v0.2.0
# MAX_UPLOAD_SIZE=200m
# JWT_SECRET= / APP_TOKEN_SECRET=       # auto-generated into data/kairso/secrets.env

# Your own PostgreSQL (15+): set COMPOSE_FILE=docker-compose.yml and
# DB_HOST=  DB_PORT=5432  DB_USER=  DB_NAME=  DB_SSLMODE=require

# Your own S3-compatible storage (S3, R2, B2, Wasabi…):
# MINIO_ENDPOINT=s3.example.com  MINIO_USE_SSL=true  MINIO_BUCKET=
# MINIO_PUBLIC_URL=https://cdn.example.com   # public URL of the bucket

# Your own Redis: REDIS_HOST=  REDIS_PORT=6379
